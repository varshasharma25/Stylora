# ==============================================================================
# Stylora — Environment Variables Template (.env.example)
# ==============================================================================
# Instructions:
# 1. In Linux/macOS file managers, files starting with a dot (like .env) are HIDDEN.
#    Press [Ctrl + H] (Linux) or [Cmd + Shift + .] (Mac) to view hidden files.
# 2. Copy this template to create your local active configuration:
#    cp .env.example .env
# 3. Enter your Gemini API key in .env below.
# 4. NEVER commit your actual .env file or production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO SETTINGS
# ------------------------------------------------------------------------------
# Set to True for local development; ALWAYS set to False in production.
DEBUG=True

# Local development secret key (replace with a 50+ char random string in production)
# In production, generate with: python -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=django-insecure-change-this-local-dev-secret-key-for-stylora-project-982173

# Comma-separated list of valid host/domain names
ALLOWED_HOSTS=127.0.0.1,localhost

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL=sqlite:///db.sqlite3

# Production (PostgreSQL example):
# DATABASE_URL=postgres://stylora_user:your_db_password@localhost:5432/stylora_db

# ------------------------------------------------------------------------------
# 3. EXTERNAL AI SERVICES (Google Gemini Flash)
# ------------------------------------------------------------------------------
# Obtain your free Gemini API key from Google AI Studio:
# https://aistudio.google.com/
# Paste your key below without quotes:
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. OPTIONAL PRODUCTION SECURITY SETTINGS (Only active when DEBUG=False)
# ------------------------------------------------------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
